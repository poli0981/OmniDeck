<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spikes #1–#4 (issues #2–#5): DRM, sign-in, memory ladder, CDP console capture in WebView2. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LabPages\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
