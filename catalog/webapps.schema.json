{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniDeck web app catalog",
  "description": "Curated web apps OmniDeck can run and how each one is sandboxed. See docs/WEBAPP-CATALOG.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updated", "apps"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint pointing at this schema; ignored by the app."
    },
    "schemaVersion": {
      "const": 1
    },
    "updated": {
      "type": "string",
      "description": "Date of the last content change (yyyy-MM-dd).",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "domain": {
      "type": "string",
      "description": "Lowercase domain or subdomain: no scheme, port, path, or wildcard.",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startUrl", "profile", "navAllow", "popupAllow", "notifications", "audioPin"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "Stable identifier; also the settings key."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "startUrl": {
          "type": "string",
          "description": "Initial navigation target; HTTPS only.",
          "maxLength": 2048,
          "pattern": "^https://[^\\s/?#]+(/\\S*)?$"
        },
        "profile": {
          "$ref": "#/$defs/slug",
          "description": "Cookie/profile group; entries sharing a value share sign-in. Reserved group: google."
        },
        "navAllow": {
          "type": "array",
          "description": "Domains the main frame may navigate to (whole-label suffix match).",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domain" }
        },
        "popupAllow": {
          "type": "array",
          "description": "Domains whose popups open in-app on the same profile (SSO flows).",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/domain" }
        },
        "notifications": {
          "type": "boolean"
        },
        "audioPin": {
          "type": "boolean"
        }
      }
    }
  }
}
