<ui:FluentWindow x:Class="OmniDeck.App.Legal.OdLegalWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:legal="clr-namespace:OmniDeck.App.Legal"
                 xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{res:OdLoc Legal_Title}"
                 Width="860"
                 Height="680"
                 MinWidth="560"
                 MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <legal:OdMarkdownConverter x:Key="Markdown" />
        <BooleanToVisibilityConverter x:Key="Visible" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{res:OdLoc Legal_Title}" Grid.Row="0" />
        <TextBlock Grid.Row="1"
                   Margin="{DynamicResource Od.Padding.Card}"
                   Text="{res:OdLoc Legal_Intro}"
                   TextWrapping="Wrap" />
        <TabControl Grid.Row="2"
                    Margin="{DynamicResource Od.Padding.Control}"
                    ItemsSource="{Binding Pages}"
                    SelectedIndex="0">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type legal:OdLegalPage}">
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type legal:OdLegalPage}">
                    <FlowDocumentScrollViewer Document="{Binding Markdown, Converter={StaticResource Markdown}}"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <DockPanel Grid.Row="3" Margin="{DynamicResource Od.Padding.Card}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           Appearance="Primary"
                           Command="{Binding ContinueCommand}"
                           Content="{res:OdLoc Legal_Continue}"
                           Visibility="{Binding AsksForAcknowledgment, Converter={StaticResource Visible}}" />
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           Command="{Binding QuitCommand}"
                           Content="{Binding QuitText}" />
            </StackPanel>
            <CheckBox VerticalAlignment="Center"
                      Content="{res:OdLoc Legal_HaveRead}"
                      IsChecked="{Binding HasRead}"
                      Visibility="{Binding AsksForAcknowledgment, Converter={StaticResource Visible}}" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
