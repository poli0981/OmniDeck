<ui:FluentWindow x:Class="OmniDeck.App.Settings.OdOnboardingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
                 xmlns:settings="clr-namespace:OmniDeck.App.Settings"
                 xmlns:theming="clr-namespace:OmniDeck.App.Theming"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{res:OdLoc Onboarding_Title}"
                 Width="760"
                 Height="560"
                 MinWidth="520"
                 MinHeight="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{res:OdLoc Onboarding_Title}" Grid.Row="0" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{DynamicResource Od.Padding.Card}">
                <TextBlock FontSize="{DynamicResource Od.Font.H1}"
                           FontWeight="SemiBold"
                           Text="{res:OdLoc Onboarding_Title}" />
                <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{res:OdLoc Onboarding_Intro}"
                           TextWrapping="Wrap" />
                <TextBlock FontWeight="SemiBold" Text="{res:OdLoc Settings_Language}" />
                <ComboBox Width="260"
                          Margin="{DynamicResource Od.Margin.Item}"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="{res:OdLoc Settings_Language}"
                          DisplayMemberPath="Title"
                          ItemsSource="{Binding Languages}"
                          SelectedValue="{Binding Language}"
                          SelectedValuePath="Value" />
                <TextBlock FontWeight="SemiBold" Text="{res:OdLoc Settings_Preset}" />
                <ListBox Margin="{DynamicResource Od.Margin.Item}"
                         AutomationProperties.Name="{res:OdLoc Settings_Preset}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Presets}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedValue="{Binding Preset}"
                         SelectedValuePath="Name">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type settings:OdPresetOption}">
                            <!--  The card's text has its preset's own layer: each card shows that preset's sizes and text colors.  -->
                            <Border Width="200" Padding="{DynamicResource Od.Padding.Control}">
                                <StackPanel theming:OdPresetPreview.Layer="{Binding Preview}">
                                    <TextBlock FontSize="{DynamicResource Od.Font.H2}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <TextBlock FontSize="{DynamicResource Od.Font.Base}"
                                               Style="{StaticResource PresetHint}"
                                               Text="{Binding Hint}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{res:OdLoc Onboarding_Later}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <ui:Button Grid.Row="2"
                   Margin="{DynamicResource Od.Padding.Card}"
                   HorizontalAlignment="Right"
                   Appearance="Primary"
                   Command="{Binding FinishCommand}"
                   Content="{res:OdLoc Onboarding_Done}" />
    </Grid>
</ui:FluentWindow>
