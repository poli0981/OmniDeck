<UserControl x:Class="OmniDeck.App.Settings.OdSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
             xmlns:settings="clr-namespace:OmniDeck.App.Settings"
             xmlns:shell="clr-namespace:OmniDeck.App.Shell"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--  The navigation view's frame does not pass the window's text color down: pages set their own.  -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel Margin="{DynamicResource Od.Padding.Card}">
        <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                   DockPanel.Dock="Top"
                   FontSize="{DynamicResource Od.Font.H1}"
                   FontWeight="SemiBold"
                   Text="{res:OdLoc Settings_Title}" />
        <TabControl SelectedIndex="{Binding SectionIndex}">
            <TabItem Header="{res:OdLoc Settings_General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_Language}">
                            <ComboBox MinWidth="200"
                                      AutomationProperties.Name="{res:OdLoc Settings_Language}"
                                      DisplayMemberPath="Title"
                                      ItemsSource="{Binding Languages}"
                                      SelectedValue="{Binding Language}"
                                      SelectedValuePath="Value" />
                        </ui:CardControl>
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_CloseToTray}">
                            <ui:ToggleSwitch AutomationProperties.Name="{res:OdLoc Settings_CloseToTray}" IsChecked="{Binding CloseToTray}" />
                        </ui:CardControl>
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_StartWithWindows}">
                            <ui:ToggleSwitch AutomationProperties.Name="{res:OdLoc Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{res:OdLoc Settings_Appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_Theme}">
                            <ComboBox MinWidth="200"
                                      AutomationProperties.Name="{res:OdLoc Settings_Theme}"
                                      DisplayMemberPath="Title"
                                      ItemsSource="{Binding Themes}"
                                      SelectedValue="{Binding Theme}"
                                      SelectedValuePath="Value" />
                        </ui:CardControl>
                        <TextBlock Margin="{DynamicResource Od.Padding.Control}"
                                   FontWeight="SemiBold"
                                   Text="{res:OdLoc Settings_Preset}" />
                        <ListBox Margin="{DynamicResource Od.Margin.Item}"
                                 AutomationProperties.Name="{res:OdLoc Settings_Preset}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding Presets}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectedValue="{Binding Preset}"
                                 SelectedValuePath="Name">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:OdPresetOption}">
                                    <StackPanel Width="220" Margin="{DynamicResource Od.Padding.Control}">
                                        <TextBlock FontSize="{DynamicResource Od.Font.H2}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}" />
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Hint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_FontScale}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="220"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{res:OdLoc Settings_FontScale}"
                                        IsSnapToTickEnabled="True"
                                        Maximum="1.4"
                                        Minimum="0.85"
                                        TickFrequency="0.05"
                                        Value="{Binding FontScale}" />
                                <TextBlock Margin="{DynamicResource Od.Padding.Control}"
                                           VerticalAlignment="Center"
                                           Text="{Binding FontScale, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_Motion}">
                            <ui:ToggleSwitch AutomationProperties.Name="{res:OdLoc Settings_Motion}" IsChecked="{Binding MotionEnabled}" />
                        </ui:CardControl>
                        <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_AccentSystem}">
                            <ui:ToggleSwitch AutomationProperties.Name="{res:OdLoc Settings_AccentSystem}" IsChecked="{Binding UseSystemAccent}" />
                        </ui:CardControl>
                        <ItemsControl Margin="{DynamicResource Od.Margin.Item}"
                                      Focusable="False"
                                      ItemsSource="{Binding AccentSwatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{DynamicResource Od.HitTarget.Min}"
                                            Height="{DynamicResource Od.HitTarget.Min}"
                                            Margin="{DynamicResource Od.Padding.Control}"
                                            AutomationProperties.Name="{Binding}"
                                            Background="{Binding}"
                                            Command="{Binding DataContext.ChooseAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{res:OdLoc Settings_Memory}">
                <DockPanel>
                    <WrapPanel Margin="{DynamicResource Od.Padding.Control}" DockPanel.Dock="Top">
                        <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                            <TextBlock Text="{res:OdLoc Settings_IdleAfter}" />
                            <ui:NumberBox Width="180"
                                          AutomationProperties.Name="{res:OdLoc Settings_IdleAfter}"
                                          MaxDecimalPlaces="0"
                                          Maximum="10080"
                                          Minimum="1"
                                          Value="{Binding IdleAfterMinutes}" />
                        </StackPanel>
                        <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                            <TextBlock Text="{res:OdLoc Settings_HibernateAfter}" />
                            <ui:NumberBox Width="180"
                                          AutomationProperties.Name="{res:OdLoc Settings_HibernateAfter}"
                                          MaxDecimalPlaces="0"
                                          Maximum="10080"
                                          Minimum="1"
                                          Value="{Binding HibernateAfterMinutes}" />
                        </StackPanel>
                        <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                            <TextBlock Text="{res:OdLoc Settings_SoftCap}" />
                            <ui:NumberBox Width="180"
                                          AutomationProperties.Name="{res:OdLoc Settings_SoftCap}"
                                          MaxDecimalPlaces="0"
                                          Minimum="0"
                                          Value="{Binding SoftCapMegabytes}" />
                        </StackPanel>
                        <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                            <TextBlock Text="{res:OdLoc Settings_HardCap}" />
                            <ui:NumberBox Width="180"
                                          AutomationProperties.Name="{res:OdLoc Settings_HardCap}"
                                          MaxDecimalPlaces="0"
                                          Minimum="0"
                                          Value="{Binding HardCapMegabytes}" />
                        </StackPanel>
                    </WrapPanel>
                    <shell:OdMemoryPage DataContext="{Binding Memory}" />
                </DockPanel>
            </TabItem>

            <TabItem Header="{res:OdLoc Settings_Data}">
                <StackPanel Margin="{DynamicResource Od.Padding.Control}">
                    <ui:CardControl Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Settings_DataFolder}">
                        <ui:Button Command="{Binding OpenDataFolderCommand}" Content="{res:OdLoc Settings_OpenDataFolder}" />
                    </ui:CardControl>
                    <TextBlock Margin="{DynamicResource Od.Padding.Control}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding DataFolder}" />
                    <StackPanel Margin="{DynamicResource Od.Margin.Item}" Orientation="Horizontal">
                        <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                   Click="OnExportClick"
                                   Content="{res:OdLoc Settings_Export}" />
                        <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                   Click="OnImportClick"
                                   Content="{res:OdLoc Settings_Import}" />
                    </StackPanel>
                    <TextBlock Margin="{DynamicResource Od.Padding.Control}" Text="{Binding DataMessage}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="{res:OdLoc Settings_About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{DynamicResource Od.Padding.Control}" DataContext="{Binding About}">
                        <TextBlock FontSize="{DynamicResource Od.Font.H2}"
                                   FontWeight="SemiBold"
                                   Text="{res:OdLoc App_Name}" />
                        <TextBlock Margin="{DynamicResource Od.Margin.Item}" Text="{Binding VersionText}" />
                        <StackPanel Margin="{DynamicResource Od.Margin.Item}" Orientation="Horizontal">
                            <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                       Command="{Binding CheckCommand}"
                                       Content="{res:OdLoc About_CheckUpdates}" />
                            <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                       Appearance="Primary"
                                       Command="{Binding DownloadCommand}"
                                       Content="{res:OdLoc About_Download}"
                                       Visibility="{Binding CanDownload, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding StatusText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="{DynamicResource Od.Padding.Control}"
                                   FontWeight="SemiBold"
                                   Text="{res:OdLoc About_Links}" />
                        <WrapPanel Margin="{DynamicResource Od.Margin.Item}">
                            <ui:HyperlinkButton Command="{Binding OpenLinkCommand}"
                                                CommandParameter="{x:Static settings:OdAboutViewModel.Repository}"
                                                Content="{res:OdLoc About_GitHub}" />
                            <ui:HyperlinkButton Command="{Binding OpenLinkCommand}"
                                                CommandParameter="{x:Static settings:OdAboutViewModel.Discussions}"
                                                Content="{res:OdLoc About_Discussions}" />
                            <ui:HyperlinkButton Command="{Binding OpenLinkCommand}"
                                                CommandParameter="{x:Static settings:OdAboutViewModel.Discord}"
                                                Content="{res:OdLoc About_Discord}" />
                            <ui:HyperlinkButton Command="{Binding ShowLegalCommand}" Content="{res:OdLoc About_Legal}" />
                        </WrapPanel>
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{res:OdLoc About_Credits}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
