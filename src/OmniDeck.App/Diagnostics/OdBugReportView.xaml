<UserControl x:Class="OmniDeck.App.Diagnostics.OdBugReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core">
    <StackPanel>
        <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                   Text="{res:OdLoc Report_Intro}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="{DynamicResource Od.Padding.Control}" Text="{res:OdLoc Report_Subject}" />
        <ComboBox Margin="{DynamicResource Od.Margin.Item}"
                  AutomationProperties.Name="{res:OdLoc Report_Subject}"
                  ItemsSource="{Binding Subjects}"
                  SelectedValue="{Binding Subject}"
                  SelectedValuePath="Value" />
        <TextBlock Margin="{DynamicResource Od.Padding.Control}" Text="{res:OdLoc Report_Preview}" />
        <TextBox Height="280"
                 AutomationProperties.Name="{res:OdLoc Report_Preview}"
                 FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 Text="{Binding Preview, Mode=OneWay}"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" />
    </StackPanel>
</UserControl>
