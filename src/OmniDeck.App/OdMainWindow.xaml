<ui:FluentWindow x:Class="OmniDeck.App.OdMainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OmniDeck"
                 Width="960"
                 Height="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="OmniDeck" Grid.Row="0" />
        <!--  Kickoff placeholder: the real shell (navigation, module host) arrives in P1.  -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <ui:TextBlock HorizontalAlignment="Center"
                          FontTypography="Title"
                          Text="OmniDeck" />
            <ui:TextBlock x:Name="VersionText"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Center"
                          Appearance="Secondary" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
