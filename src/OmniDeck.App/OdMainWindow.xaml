<ui:FluentWindow x:Class="OmniDeck.App.OdMainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
                 xmlns:shell="clr-namespace:OmniDeck.App.Shell"
                 xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{res:OdLoc App_Name}"
                 Width="1100"
                 Height="720"
                 MinWidth="640"
                 MinHeight="420"
                 Closing="OnClosing"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="OnPreviewKeyDown"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <!--  Sidebar labels at the preset's text size: WPF-UI's item template sets 14 px on its content.  -->
        <DataTemplate x:Key="NavLabel">
            <TextBlock FontSize="{DynamicResource Od.Font.Base}"
                       Text="{Binding}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar"
                     Title="{res:OdLoc App_Name}"
                     Grid.Row="0">
            <!--  Looks like a search box; opens the command palette, as Ctrl+K does.  -->
            <ui:TitleBar.CenterContent>
                <ui:Button Width="360"
                           Margin="{DynamicResource Od.Margin.Leading}"
                           HorizontalContentAlignment="Left"
                           AutomationProperties.Name="{res:OdLoc Shell_Search}"
                           Click="OnSearchClick"
                           ToolTip="{res:OdLoc Shell_SearchShortcut}">
                    <DockPanel>
                        <ui:SymbolIcon Margin="{DynamicResource Od.Margin.Inline}"
                                       DockPanel.Dock="Left"
                                       Symbol="Search24" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{res:OdLoc Shell_Search}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </ui:Button>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <!--
            Chrome only: items are built in code from OdShellViewModel.Sidebar and every navigation goes through it.
            OdNavigationView gives screen readers the sidebar's items; being a subclass, it takes WPF-UI's style by name.
        -->
        <shell:OdNavigationView x:Name="RootNavigation"
                                Grid.Row="1"
                                FrameMargin="0"
                                IsBackButtonVisible="Collapsed"
                                IsPaneToggleVisible="True"
                                OpenPaneLength="240"
                                PaneDisplayMode="Left"
                                Style="{StaticResource {x:Type ui:NavigationView}}"
                                TitleBar="{Binding ElementName=AppTitleBar, Mode=OneWay}">
            <shell:OdNavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="RootSnackbar" VerticalAlignment="Bottom" />
                </Grid>
            </shell:OdNavigationView.ContentOverlay>
        </shell:OdNavigationView>

        <!--  In-window dialogs cover the whole window, title bar included.  -->
        <ui:ContentDialogHost x:Name="RootDialogHost"
                              Grid.Row="0"
                              Grid.RowSpan="2" />

        <!--
            The tray icon lives as long as this window, which closing only hides (docs/SPEC.md §2).
            Its image is drawn in code (OdTrayIcon), never with GeneratedIconSource.
        -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="0"
                        NoLeftClickDelay="True"
                        ToolTipText="{res:OdLoc App_Name}"
                        TrayBalloonTipClicked="OnTrayNotificationClicked"
                        TrayLeftMouseUp="OnTrayOpen">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="OnTrayMenuOpened">
                    <MenuItem Click="OnTrayOpen" Header="{res:OdLoc Tray_Open}" />
                    <MenuItem Click="OnTrayQuickTimer" Header="{res:OdLoc Tray_QuickTimer}" />
                    <!--  Shown while a media module has something loaded (docs/SPEC.md §2).  -->
                    <Separator x:Name="TrayMediaSeparator" Visibility="Collapsed" />
                    <MenuItem x:Name="TrayNowPlaying"
                              IsEnabled="False"
                              Visibility="Collapsed" />
                    <MenuItem x:Name="TrayPlayPause"
                              Click="OnTrayPlayPause"
                              Visibility="Collapsed" />
                    <MenuItem x:Name="TrayNext"
                              Click="OnTrayNext"
                              Header="{res:OdLoc Tray_Next}"
                              Visibility="Collapsed" />
                    <MenuItem x:Name="TrayPrevious"
                              Click="OnTrayPrevious"
                              Header="{res:OdLoc Tray_Previous}"
                              Visibility="Collapsed" />
                    <Separator />
                    <MenuItem Click="OnTrayQuit" Header="{res:OdLoc Tray_Quit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
