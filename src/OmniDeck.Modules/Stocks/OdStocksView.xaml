<UserControl x:Class="OmniDeck.Modules.Stocks.OdStocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="clr-namespace:OmniDeck.Core.Accessibility;assembly=OmniDeck.Core"
             xmlns:charts="clr-namespace:OmniDeck.Modules.Charts"
             xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
             xmlns:stocks="clr-namespace:OmniDeck.Modules.Stocks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{DynamicResource Od.Padding.Card}">
            <DockPanel Margin="{DynamicResource Od.Margin.Item}">
                <ui:Button VerticalAlignment="Center"
                           Appearance="Transparent"
                           AutomationProperties.Name="{res:OdLoc Stocks_Refresh}"
                           Command="{Binding RefreshNowCommand}"
                           DockPanel.Dock="Right"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           ToolTip="{res:OdLoc Stocks_Refresh}"
                           Visibility="{Binding ShowsWatchlist, Converter={StaticResource Visible}}" />
                <StackPanel>
                    <TextBlock AutomationProperties.HeadingLevel="Level1"
                               FontSize="{DynamicResource Od.Font.H1}"
                               FontWeight="SemiBold"
                               Text="{res:OdLoc Stocks_Name}" />
                    <TextBlock FontSize="{DynamicResource Od.Font.Caption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding Credits}"
                               Visibility="{Binding HasKey, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>

            <ui:InfoBar Margin="{DynamicResource Od.Margin.Item}"
                        IsClosable="False"
                        IsOpen="{Binding HasStatus}"
                        Message="{Binding Status}"
                        Severity="{Binding StatusSeverity}" />
            <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding IntervalNote}"
                       TextWrapping="Wrap" />

            <ui:Card Margin="{DynamicResource Od.Margin.Tile}" Visibility="{Binding ShowsSetup, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                               AutomationProperties.HeadingLevel="Level2"
                               FontSize="{DynamicResource Od.Font.H2}"
                               FontWeight="SemiBold"
                               Text="{res:OdLoc Stocks_SetupTitle}" />
                    <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                               Text="{res:OdLoc Stocks_SetupBody}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="{DynamicResource Od.Margin.Item}">
                        <Hyperlink NavigateUri="https://twelvedata.com/register" RequestNavigate="OnLinkNavigate">
                            <Run Text="{res:OdLoc Stocks_GetKey}" />
                        </Hyperlink>
                    </TextBlock>
                    <ui:PasswordBox Margin="{DynamicResource Od.Margin.Item}"
                                    AutomationProperties.Name="{res:OdLoc Stocks_KeyLabel}"
                                    Password="{Binding KeyDraft, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="{res:OdLoc Stocks_KeyLabel}">
                        <ui:PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding TestKeyCommand}" />
                        </ui:PasswordBox.InputBindings>
                    </ui:PasswordBox>
                    <StackPanel Margin="{DynamicResource Od.Margin.Item}" Orientation="Horizontal">
                        <ui:Button Margin="{DynamicResource Od.Margin.Tile}"
                                   Appearance="Primary"
                                   Command="{Binding TestKeyCommand}"
                                   Content="{res:OdLoc Stocks_TestAndSave}" />
                        <ui:Button Command="{Binding CancelKeyCommand}"
                                   Content="{res:OdLoc Stocks_Cancel}"
                                   Visibility="{Binding IsEditingKey, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <a11y:OdStatusText AutomationProperties.LiveSetting="Assertive"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding KeyMessage}"
                                       TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <StackPanel Visibility="{Binding ShowsWatchlist, Converter={StaticResource Visible}}">
                <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{res:OdLoc Stocks_Empty}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <ListBox x:Name="Watchlist"
                         Margin="{DynamicResource Od.Margin.Item}"
                         AutomationProperties.Name="{res:OdLoc Stocks_Watchlist}"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete"
                                    Command="{Binding RemoveCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=Watchlist}" />
                        <KeyBinding Key="Up"
                                    Command="{Binding MoveUpCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=Watchlist}"
                                    Modifiers="Alt" />
                        <KeyBinding Key="Down"
                                    Command="{Binding MoveDownCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=Watchlist}"
                                    Modifiers="Alt" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type stocks:OdWatchRowViewModel}">
                            <Grid Margin="{DynamicResource Od.Padding.Control}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Header="{res:OdLoc Stocks_MoveUp}" />
                                        <MenuItem Command="{Binding PlacementTarget.Tag.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Header="{res:OdLoc Stocks_MoveDown}" />
                                        <MenuItem Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Header="{res:OdLoc Stocks_Remove}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Symbol}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="{DynamicResource Od.Font.Caption}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Text="{Binding Note}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <charts:OdSparkline Grid.Column="1"
                                                    Height="{DynamicResource Od.HitTarget.Min}"
                                                    Margin="{DynamicResource Od.Padding.Control}"
                                                    VerticalAlignment="Center"
                                                    Values="{Binding Sparkline}" />
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            TextElement.FontWeight="SemiBold">
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Price}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding Change}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="{DynamicResource Od.Font.Caption}"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding AsOf}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:Card Margin="{DynamicResource Od.Margin.Tile}" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}">
                    <StackPanel DataContext="{Binding Detail}">
                        <DockPanel Margin="{DynamicResource Od.Margin.Item}">
                            <ui:Button Appearance="Transparent"
                                       AutomationProperties.Name="{res:OdLoc Stocks_CloseDetail}"
                                       Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       DockPanel.Dock="Right"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       ToolTip="{res:OdLoc Stocks_CloseDetail}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="{DynamicResource Od.Font.H2}"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <WrapPanel Margin="{DynamicResource Od.Margin.Item}" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock Margin="{DynamicResource Od.Margin.Tile}" Text="{Binding Exchange}" />
                            <TextBlock Margin="{DynamicResource Od.Margin.Tile}" Text="{Binding DayRange}" />
                            <TextBlock Margin="{DynamicResource Od.Margin.Tile}" Text="{Binding YearRange}" />
                            <TextBlock Margin="{DynamicResource Od.Margin.Tile}" Text="{Binding Volume}" />
                        </WrapPanel>
                        <ListBox Margin="{DynamicResource Od.Margin.Item}"
                                 AutomationProperties.Name="{res:OdLoc Stocks_Ranges}"
                                 ItemsSource="{Binding Ranges}"
                                 SelectedItem="{Binding SelectedRange}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <ui:ProgressRing Margin="{DynamicResource Od.Margin.Item}"
                                         HorizontalAlignment="Left"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
                        <a11y:OdStatusText Margin="{DynamicResource Od.Margin.Item}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Message}"
                                           Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" />
                        <charts:OdCandleChart Margin="{DynamicResource Od.Margin.Item}"
                                              Bars="{Binding Bars}"
                                              CursorIndex="{Binding Cursor}"
                                              Readout="{Binding Readout}"
                                              Summary="{Binding Summary}" />
                        <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding Readout}"
                                   TextWrapping="Wrap" />
                        <CheckBox Margin="{DynamicResource Od.Margin.Item}"
                                  Content="{res:OdLoc Stocks_ShowTable}"
                                  IsChecked="{Binding ShowTable}" />
                        <ListView MaxHeight="320"
                                  Margin="{DynamicResource Od.Margin.Item}"
                                  AutomationProperties.Name="{res:OdLoc Stocks_Table}"
                                  ItemsSource="{Binding Table}"
                                  Visibility="{Binding ShowTable, Converter={StaticResource Visible}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn DisplayMemberBinding="{Binding Date}" Header="{res:OdLoc Stocks_ColumnDate}" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Open}" Header="{res:OdLoc Stocks_ColumnOpen}" />
                                    <GridViewColumn DisplayMemberBinding="{Binding High}" Header="{res:OdLoc Stocks_ColumnHigh}" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Low}" Header="{res:OdLoc Stocks_ColumnLow}" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Close}" Header="{res:OdLoc Stocks_ColumnClose}" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Volume}" Header="{res:OdLoc Stocks_ColumnVolume}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </ui:Card>
                <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                           AutomationProperties.HeadingLevel="Level2"
                           FontSize="{DynamicResource Od.Font.H2}"
                           FontWeight="SemiBold"
                           Text="{res:OdLoc Stocks_AddListing}" />
                <DockPanel Margin="{DynamicResource Od.Margin.Item}">
                    <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                               Appearance="Primary"
                               Command="{Binding SearchCommand}"
                               Content="{res:OdLoc Stocks_SearchButton}"
                               DockPanel.Dock="Right" />
                    <ui:TextBox AutomationProperties.Name="{res:OdLoc Stocks_Search}"
                                PlaceholderText="{res:OdLoc Stocks_Search}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                </DockPanel>
                <a11y:OdStatusText Margin="{DynamicResource Od.Margin.Item}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SearchMessage}"
                                   TextWrapping="Wrap" />
                <ItemsControl Focusable="False" ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type stocks:OdListingRowViewModel}">
                            <DockPanel Margin="{DynamicResource Od.Padding.Control}">
                                <ui:Button AutomationProperties.Name="{Binding AddName}"
                                           Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           Content="{res:OdLoc Stocks_Add}"
                                           DockPanel.Dock="Right"
                                           IsEnabled="{Binding CanAdd}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="{DynamicResource Od.Font.Caption}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Detail}" />
                                    <TextBlock FontSize="{DynamicResource Od.Font.Caption}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Text="{Binding PlanNote}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Margin="{DynamicResource Od.Margin.Item}" Header="{res:OdLoc Stocks_KeyPanel}">
                    <StackPanel>
                        <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                                   Text="{Binding Plan}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Margin="{DynamicResource Od.Margin.Tile}"
                                       Command="{Binding ChangeKeyCommand}"
                                       Content="{res:OdLoc Stocks_ChangeKey}" />
                            <ui:Button Command="{Binding RemoveKeyCommand}" Content="{res:OdLoc Stocks_RemoveKey}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                       FontSize="{DynamicResource Od.Font.Caption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap">
                <Run Text="{res:OdLoc Stocks_Disclaimer}" />
                <Hyperlink NavigateUri="https://twelvedata.com/" RequestNavigate="OnLinkNavigate">
                    <Run Text="{res:OdLoc Stocks_DataBy}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
