<UserControl x:Class="OmniDeck.Modules.Media.OdMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:OmniDeck.Modules.Media"
             xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             AllowDrop="True"
             Drop="OnDrop"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  The video is a native window; its WPF content is drawn in an overlay window above it (docs/spikes/06-libvlcsharp.md).  -->
        <vlc:VideoView x:Name="Video" Grid.Column="0">
            <!--  Opaque where there is no picture: libVLC's video window is blank until a video plays, and stays so for audio.  -->
            <Grid Focusable="True"
                  KeyDown="OnVideoKeyDown"
                  MouseLeftButtonDown="OnVideoMouseDown">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                        <Style.Triggers>
                            <!--  Not quite transparent: a click on a fully clear pixel of the overlay window falls through to the video window.  -->
                            <DataTrigger Binding="{Binding ShowsVideo}" Value="True">
                                <Setter Property="Background" Value="#01000000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />
                <Border Grid.Row="1"
                        Padding="{DynamicResource Od.Padding.Card}"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                    <!--  The seek bar has a row of its own, so it keeps its length beside the queue; when the bar is narrow, the volume slider gives way first.  -->
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding TimeText}" />
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Slider AutomationProperties.Name="{res:OdLoc Media_Seek}"
                                IsMoveToPointEnabled="True"
                                Maximum="{Binding Length}"
                                Minimum="0"
                                Value="{Binding Position, Delay=150}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*"
                                                  MinWidth="64"
                                                  MaxWidth="136" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button AutomationProperties.Name="{res:OdLoc Media_Previous}"
                                           Command="{Binding PreviousCommand}"
                                           Icon="{ui:SymbolIcon Previous24}"
                                           ToolTip="{res:OdLoc Media_Previous}" />
                                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                           AutomationProperties.Name="{res:OdLoc Media_PlayPause}"
                                           Command="{Binding PlayPauseCommand}"
                                           Icon="{ui:SymbolIcon Play24}"
                                           ToolTip="{res:OdLoc Media_PlayPause}" />
                                <ui:Button AutomationProperties.Name="{res:OdLoc Media_Next}"
                                           Command="{Binding NextCommand}"
                                           Icon="{ui:SymbolIcon Next24}"
                                           ToolTip="{res:OdLoc Media_Next}" />
                                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                           AutomationProperties.Name="{res:OdLoc Media_Stop}"
                                           Command="{Binding StopCommand}"
                                           Icon="{ui:SymbolIcon Stop24}"
                                           ToolTip="{res:OdLoc Media_Stop}" />
                            </StackPanel>
                            <ui:Button Grid.Column="2"
                                       AutomationProperties.Name="{res:OdLoc Media_Mute}"
                                       Command="{Binding ToggleMuteCommand}"
                                       Icon="{ui:SymbolIcon Speaker224}"
                                       ToolTip="{res:OdLoc Media_Mute}" />
                            <!--  MinWidth: WPF-UI's style asks for 104 px, which a narrow column would clip, thumb and all.  -->
                            <Slider Grid.Column="3"
                                    MinWidth="0"
                                    Margin="{DynamicResource Od.Padding.Control}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{res:OdLoc Media_Volume}"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding Volume}" />
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                           AutomationProperties.Name="{res:OdLoc Media_More}"
                                           Click="OnMoreClick"
                                           Icon="{ui:SymbolIcon MoreHorizontal24}"
                                           ToolTip="{res:OdLoc Media_More}" />
                                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                           AutomationProperties.Name="{res:OdLoc Media_Fullscreen}"
                                           Click="OnFullscreenClick"
                                           Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                           ToolTip="{res:OdLoc Media_Fullscreen}"
                                           Visibility="{Binding IsWindowed, Converter={StaticResource Visible}}" />
                                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                           AutomationProperties.Name="{res:OdLoc Media_ExitFullscreen}"
                                           Click="OnFullscreenClick"
                                           Icon="{ui:SymbolIcon FullScreenMinimize24}"
                                           ToolTip="{res:OdLoc Media_ExitFullscreen}"
                                           Visibility="{Binding IsFullscreen, Converter={StaticResource Visible}}" />
                                <ui:Button AutomationProperties.Name="{res:OdLoc Media_Queue}"
                                           Command="{Binding ToggleQueueCommand}"
                                           Icon="{ui:SymbolIcon TextBulletListLtr24}"
                                           ToolTip="{res:OdLoc Media_Queue}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>

        <DockPanel Grid.Column="1"
                   Width="300"
                   Visibility="{Binding ShowsQueue, Converter={StaticResource Visible}}">
            <WrapPanel Margin="{DynamicResource Od.Padding.Control}" DockPanel.Dock="Top">
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           Click="OnAddFiles"
                           Content="{res:OdLoc Media_AddFiles}"
                           Icon="{ui:SymbolIcon Add24}" />
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           Click="OnAddFolder"
                           Content="{res:OdLoc Media_AddFolder}"
                           Icon="{ui:SymbolIcon Folder24}" />
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           Click="OnSavePlaylist"
                           Content="{res:OdLoc Media_SavePlaylist}"
                           Icon="{ui:SymbolIcon Save24}"
                           IsEnabled="{Binding HasItems}" />
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           Command="{Binding ClearCommand}"
                           Content="{res:OdLoc Media_Clear}"
                           Icon="{ui:SymbolIcon Delete24}"
                           IsEnabled="{Binding HasItems}" />
            </WrapPanel>
            <TextBlock Margin="{DynamicResource Od.Margin.Item}"
                       DockPanel.Dock="Top"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{res:OdLoc Media_Hint}"
                       TextWrapping="Wrap" />
            <ListBox x:Name="Queue"
                     AutomationProperties.Name="{res:OdLoc Media_Queue}"
                     ItemsSource="{Binding Items}"
                     MouseDoubleClick="OnQueueDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type media:OdMediaItem}">
                        <DockPanel>
                            <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                                       AutomationProperties.Name="{res:OdLoc Media_Remove}"
                                       Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                       CommandParameter="{Binding}"
                                       DockPanel.Dock="Right"
                                       Icon="{ui:SymbolIcon Dismiss24}"
                                       ToolTip="{res:OdLoc Media_Remove}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
