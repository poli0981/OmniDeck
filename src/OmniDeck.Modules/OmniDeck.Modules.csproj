<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Resources/Strings.resx is English; the resource manager never probes for an "en" satellite. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- The built-in mini-apps (docs/SPEC.md §3). They depend on Core's contract only, never on the shell. -->

  <ItemGroup>
    <InternalsVisibleTo Include="OmniDeck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniDeck.Core\OmniDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
