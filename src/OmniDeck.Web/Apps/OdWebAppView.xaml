<UserControl x:Class="OmniDeck.Web.Apps.OdWebAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:OmniDeck.Core.Localization;assembly=OmniDeck.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Notices and questions sit above the browser: WebView2 is a native window that no WPF element,
            not even a content dialog, can cover.
        -->
        <StackPanel Grid.Row="0">
            <DockPanel x:Name="NoticePanel"
                       Margin="{DynamicResource Od.Margin.Item}"
                       Visibility="Collapsed">
                <ui:Button x:Name="NoticeAction"
                           Margin="{DynamicResource Od.Padding.Control}"
                           VerticalAlignment="Center"
                           Click="OnNoticeAction"
                           DockPanel.Dock="Right" />
                <ui:InfoBar x:Name="Notice"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Warning" />
            </DockPanel>
            <!--  A permission question waits here until answered, and the page waits with it.  -->
            <DockPanel x:Name="QuestionPanel"
                       Margin="{DynamicResource Od.Margin.Item}"
                       Visibility="Collapsed">
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           VerticalAlignment="Center"
                           Click="OnBlock"
                           Content="{res:OdLoc Web_Block}"
                           DockPanel.Dock="Right" />
                <ui:Button Margin="{DynamicResource Od.Padding.Control}"
                           VerticalAlignment="Center"
                           Appearance="Primary"
                           Click="OnAllow"
                           Content="{res:OdLoc Web_Allow}"
                           DockPanel.Dock="Right" />
                <ui:InfoBar x:Name="Question"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational" />
            </DockPanel>
        </StackPanel>

        <Grid x:Name="BrowserHost" Grid.Row="1" />
        <ui:ProgressRing x:Name="Starting"
                         Grid.Row="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsIndeterminate="True" />
    </Grid>
</UserControl>
