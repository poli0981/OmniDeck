<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only from the start: DPAPI, toasts and the update service land here in P1. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Only for source-generated P/Invoke ([LibraryImport]); no hand-written unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniDeck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

</Project>
